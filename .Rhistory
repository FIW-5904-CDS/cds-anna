filter(!is.na(port)) %>% # filtering out rows with port == NA
arrange(port, gear) %>% # sorting the table by port and gear
mutate(
port = if_else(port == lag(port), "", port), # lag returns the previous value in a vector. Thus when previous row has the same value then set this value to "" in current row
gear = if_else(gear == lag(gear) & port == lag(port), "", gear)
) %>%
select(port, gear, lengthdata) %>%
gt() %>%
cols_label( # names of columns in printed table
port = "Port",
gear = "Gear",
lengthdata = "Length (cm)",
) %>%
