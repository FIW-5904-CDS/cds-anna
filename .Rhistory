# Create publication-style table - I create a gt table object
# I can format the numeric values, specify the column names and set table options
summary_tbl %>% #making a nice table from my summary table
gt() %>%
fmt_number(
columns = c(mean_length, mean_weight),
decimals = 1
) %>%
tab_header(
title = "Summary of White Shark Measurements by Nation",
subtitle = "Average body length and weight (n = sample size)"
) %>%
cols_label(
nation = "Nation",
mean_length = "Mean Length (cm)",
mean_weight = "Mean Weight (kg)",
n = "Sample Size"
) %>%
tab_options(
table.font.size = px(12),
table.font.names = "Helvetica",
table.width = pct(80)
)
