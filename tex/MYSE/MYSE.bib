@article{white_winter_2020,
	title = {Winter {Use} of a {Rock} {Crevice} by {Northern} {Long}-{Eared} {Myotis} ({Myotis} septentrionalis) in {Nebraska}},
	volume = {80},
	issn = {1527-0904},
	url = {https://bioone.org/journals/western-north-american-naturalist/volume-80/issue-1/064.080.0114/Winter-Use-of-a-Rock-Crevice-by-Northern-Long-Eared/10.3398/064.080.0114.full},
	doi = {10.3398/064.080.0114},
	abstract = {We used a combination of acoustic detectors, thermal imaging cameras, and mist netting to confirm the use of a rock crevice by northern long-eared myotis (Myotis septentrionalis) in winter in northeastern Nebraska. Bats roosted in a large crevice in a rock face along the Missouri River, and 5 individuals were captured emerging from the opening of the crevice in March 2017. Our study is the first to confirm the use of a rock-crevice hibernaculum by M. septentrionalis and adds to the growing literature on the winter use of rock crevices by hibernating bats in North America. As white-nose syndrome (WNS) continues to spread across North America and decimate populations of M. septentrionalis, more knowledge of hibernation requirements is necessary to develop an effective recovery plan and to monitor this threatened species.},
	language = {en},
	number = {1},
	urldate = {2025-11-06},
	journal = {Western North American Naturalist},
	author = {White, Jeremy A. and Freeman, Patricia W. and Otto, Hans W. and Lemen, Cliff A.},
	month = feb,
	year = {2020},
	pages = {114},
	file = {PDF:files/6517/White et al. - 2020 - Winter Use of a Rock Crevice by Northern Long-Eared Myotis (Myotis septentrionalis) in Nebraska.pdf:application/pdf},
}

@article{krueger_white-nose_2024,
	title = {White-nose syndrome, winter duration, and pre-hibernation climate impact abundance of reproductive female bats},
	volume = {19},
	issn = {1932-6203},
	url = {https://journals.plos.org/plosone/article?id=10.1371/journal.pone.0298515},
	doi = {10.1371/journal.pone.0298515},
	abstract = {White-nose syndrome (WNS) is an infectious disease that disrupts hibernation in bats, leading to premature exhaustion of fat stores. Though we know WNS does impact reproduction in hibernating female bats, we are unsure how these impacts are exacerbated by local climate factors. We compiled data from four southeastern U.S. states and used generalized linear mixed effects models to compare effects of WNS, pre-hibernation climate variables, and winter duration on the number of reproductive females in species across the range of WNS susceptibility. We predicted we would see a decline in the number of reproductive females in WNS-susceptible species, with the effect exaggerated by longer winter durations and pre-hibernation climate variables that lead to reductions in foraging. We found that the number of reproductive females in WNS-susceptible species was positively correlated with pre-hibernation local climate conditions conducive to foraging; however, WNS-susceptible species experienced an overall decline with the presence of WNS and as winter duration increased. Our long-term dataset provides evidence that pre-hibernation climate, specifically favorable summer weather conditions for foraging, greatly influences the reproduction, regardless of WNS status.},
	language = {en},
	number = {4},
	urldate = {2025-11-06},
	journal = {PLOS ONE},
	author = {Krueger, Sarah K. and Williams, Sarah C. and O’Keefe, Joy M. and Zirkle, Gene A. and Haase, Catherine G.},
	month = apr,
	year = {2024},
	note = {Publisher: Public Library of Science},
	keywords = {Bats, Fats, Hibernation, Humidity, Principal component analysis, Summer, White nose syndrome, Winter},
	pages = {e0298515},
	file = {Full Text PDF:files/6520/Krueger et al. - 2024 - White-nose syndrome, winter duration, and pre-hibernation climate impact abundance of reproductive f.pdf:application/pdf},
}

@article{lorch_experimental_2011,
	title = {Experimental infection of bats with {Geomyces} destructans causes white-nose syndrome},
	volume = {480},
	copyright = {2011 Springer Nature Limited},
	issn = {1476-4687},
	url = {https://www.nature.com/articles/nature10590},
	doi = {10.1038/nature10590},
	abstract = {Hibernating wild bat populations in eastern North America have suffered catastrophic decline in recent years as a result of white-nose syndrome (WNS). Colonization of the skin — on the eponymous nose — with the fungus Geomyces destructans has been linked to the disease, but other factors have been suggested as alternative causes. In a controlled experiment, it is now shown that G. destructans does infect bats, that it can be transmitted between animals and that infection causes WNS. This contrasts with recent reports that G. destructans is widespread among bats in Europe, where it seems to have no detrimental effects on carriers.},
	language = {en},
	number = {7377},
	urldate = {2025-11-06},
	journal = {Nature},
	author = {Lorch, Jeffrey M. and Meteyer, Carol U. and Behr, Melissa J. and Boyles, Justin G. and Cryan, Paul M. and Hicks, Alan C. and Ballmann, Anne E. and Coleman, Jeremy T. H. and Redell, David N. and Reeder, DeeAnn M. and Blehert, David S.},
	month = dec,
	year = {2011},
	note = {Publisher: Nature Publishing Group},
	keywords = {Zoology, Fungi, Ecology, Fungal infection},
	pages = {376--378},
	file = {Full Text PDF:files/6522/Lorch et al. - 2011 - Experimental infection of bats with Geomyces destructans causes white-nose syndrome.pdf:application/pdf},
}

